# Copy this file to .env and set the passwords of your own databases.
#   copy .env.example .env

# MongoDB. If login is enabled, use:
#   mongodb://USER:PASSWORD@127.0.0.1:27017/?authSource=admin&directConnection=true
# Characters such as @ : / # in a password must be percent encoded (@ becomes %40).
MONGO_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGO_DB=graphmart

# Neo4j Desktop: start an instance and use the password you gave it.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphmart123
NEO4J_DATABASE=neo4j

# MySQL. database/mysql/create-database.sql creates this user.
# Only the performance comparisons need MySQL.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=graphmart
MYSQL_PASSWORD=graphmart123
MYSQL_DATABASE=graphmart
