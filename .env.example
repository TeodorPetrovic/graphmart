# Defaults match the project-local databases started by `bun run db:up`
# (and docker-compose.yml). Override to point at your own servers.
MONGO_URI=mongodb://127.0.0.1:27027/?directConnection=true
MONGO_DB=graphmart
NEO4J_URI=bolt://127.0.0.1:7697
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphmart123
NEO4J_DATABASE=neo4j
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3317
MYSQL_USER=graphmart
MYSQL_PASSWORD=graphmart123
MYSQL_DATABASE=graphmart

# Optional: only needed if `bun run db:setup` cannot find the binaries itself
# MONGOD_BIN=
# MYSQLD_BIN=
# NEO4J_HOME=
# NEO4J_JAVA_HOME=
